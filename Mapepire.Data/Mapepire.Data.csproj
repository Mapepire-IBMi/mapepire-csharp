<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mapepire.Data</RootNamespace>
    <AssemblyName>Mapepire.Data</AssemblyName>
    <Description>ADO.NET data provider for Db2 for IBM i, using the Mapepire server.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\io\io.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mapepire.EntityFrameworkCore.Tests" />
  </ItemGroup>

</Project>
