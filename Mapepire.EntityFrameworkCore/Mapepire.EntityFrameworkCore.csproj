<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Mapepire.EntityFrameworkCore</RootNamespace>
    <AssemblyName>Mapepire.EntityFrameworkCore</AssemblyName>
    <Description>Entity Framework Core provider for Db2 for IBM i, using the Mapepire server.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML docs; EF1001: use of EF Core internal APIs (expected in a provider). -->
    <NoWarn>$(NoWarn);CS1591;EF1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mapepire.Data\Mapepire.Data.csproj" />
  </ItemGroup>

</Project>
