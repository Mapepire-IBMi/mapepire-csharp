<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest" Version="3.6.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mapepire.EntityFrameworkCore\Mapepire.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <!-- Offline tests run against the Mapepire mock server, downloaded once and verified against its release digest. -->
  <PropertyGroup>
    <MockServerVersion>v0.0.1</MockServerVersion>
    <MockServerSha256>91B90A6F931B04C48FB54D302932CF4A29D428141366221FF610808D4440CE3B</MockServerSha256>
    <MockServerUrl>https://github.com/Mapepire-IBMi/mapepire-mockserver/releases/download/$(MockServerVersion)/mapepire-mockserver-$(MockServerVersion).jar</MockServerUrl>
    <MockServerDownloadDir>$(BaseIntermediateOutputPath)mockserver\$(MockServerVersion)\</MockServerDownloadDir>
    <MockServerDownloadedJar>$(MockServerDownloadDir)mapepire-mockserver-$(MockServerVersion).jar</MockServerDownloadedJar>
  </PropertyGroup>

  <Target Name="DownloadMockServer" BeforeTargets="AssignTargetPaths">
    <DownloadFile Condition="!Exists('$(MockServerDownloadedJar)')" SourceUrl="$(MockServerUrl)" DestinationFolder="$(MockServerDownloadDir)" />
    <GetFileHash Files="$(MockServerDownloadedJar)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="MockServerActualSha256" />
    </GetFileHash>
    <Delete Condition="'$(MockServerActualSha256)' != '$(MockServerSha256)'" Files="$(MockServerDownloadedJar)" />
    <Error Condition="'$(MockServerActualSha256)' != '$(MockServerSha256)'" Text="The downloaded mock server jar has SHA-256 $(MockServerActualSha256), expected $(MockServerSha256)." />
    <ItemGroup>
      <None Include="$(MockServerDownloadedJar)" Link="mapepire-mockserver.jar" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Live tests reuse the server settings of the existing UnitTests project (overridable with MAPEPIRE_* environment variables). -->
  <ItemGroup>
    <None Include="..\UnitTests\unitTestSettings.json" Link="unitTestSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
